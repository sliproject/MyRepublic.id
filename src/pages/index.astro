    <script>
        // ── FAQ ACCORDION ──
        document.querySelectorAll('.faq-q').forEach(q => {
            q.addEventListener('click', () => {
                const item = q.parentElement;
                const isOpen = item.classList.contains('open');
                document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
                if (!isOpen) item.classList.add('open');
            });
        });

        // ── SCROLL REVEAL ──
        const observer = new IntersectionObserver((entries) => {
            entries.forEach((e, i) => {
                if (e.isIntersecting) {
                    setTimeout(() => e.target.classList.add('visible'), i * 70);
                    observer.unobserve(e.target);
                }
            });
        }, { threshold: 0.08 });
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

        // ── PRICING TABS ──
        document.querySelectorAll('.ptab').forEach(btn => {
            btn.addEventListener('click', () => {
                const id = btn.dataset.tab;
                document.querySelectorAll('.pricing-panel').forEach(p => p.classList.remove('active'));
                document.querySelectorAll('.ptab').forEach(b => b.classList.remove('active'));
                document.getElementById('panel-' + id).classList.add('active');
                btn.classList.add('active');
            });
        });
        document.querySelectorAll('.psubtab').forEach(btn => {
            btn.addEventListener('click', () => {
                const tabId = btn.dataset.tab;
                const subId = btn.dataset.sub;
                const panel = document.getElementById('panel-' + tabId);
                panel.querySelectorAll('.subpanel').forEach(p => p.classList.remove('active'));
                panel.querySelectorAll('.psubtab').forEach(b => b.classList.remove('active'));
                document.getElementById(tabId + '-' + subId).classList.add('active');
                btn.classList.add('active');
            });
        });

        // ── POPUP PILIHAN ──
        const overlay    = document.getElementById('modal-overlay');
        const stepPilih  = document.getElementById('step-pilih');
        const stepBantuan = document.getElementById('step-bantuan');

        function showStep(which) {
            stepPilih.classList.toggle('active', which === 'pilih');
            stepBantuan.classList.toggle('active', which === 'bantuan');
        }
        function openModal(step) {
            showStep(step || 'pilih');
            overlay.classList.add('show');
            document.body.style.overflow = 'hidden';
        }
        function closeModal() {
            overlay.classList.remove('show');
            document.body.style.overflow = '';
            try { sessionStorage.setItem('mr_popup_seen', '1'); } catch (e) {}
        }

        // Pilihan 1: Berlangganan baru -> arahkan ke halaman utama (daftar paket)
        document.getElementById('choice-baru').addEventListener('click', () => {
            closeModal();
            if (location.pathname !== '/' && location.pathname !== '/index.html' && !location.pathname.endsWith('/')) {
                location.href = '/#harga';
            } else {
                const t = document.getElementById('harga');
                if (t) t.scrollIntoView({ behavior: 'smooth' });
            }
        });
        // Pilihan 2: Komplain / tagihan / info lainnya
        document.getElementById('choice-bantuan').addEventListener('click', () => showStep('bantuan'));
        document.getElementById('btn-back').addEventListener('click', () => showStep('pilih'));
        document.getElementById('modal-close').addEventListener('click', closeModal);
        overlay.addEventListener('click', e => { if (e.target === overlay) closeModal(); });
        document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

        // Link "Pusat Bantuan" di navbar / FAQ langsung membuka info bantuan
        document.querySelectorAll('[data-open-bantuan]').forEach(el => {
            el.addEventListener('click', e => { e.preventDefault(); openModal('bantuan'); });
        });

        // Tampilkan popup saat halaman pertama kali dibuka (sekali per sesi)
        window.addEventListener('load', () => {
            let seen = false;
            try { seen = sessionStorage.getItem('mr_popup_seen') === '1'; } catch (e) {}
            if (!seen) setTimeout(() => openModal('pilih'), 400);
        });
    </script>
